      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 8,
      "title": "Served From: Executor vs Database Fallback",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(relay_requests_served_total[1m])) by (served_from)",
          "legendFormat": "Served From: {{ served_from }}",
          "refId": "A"

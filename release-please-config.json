{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "go",
      "package-name": "relay",
      "include-component-in-tag": false,
      "changelog-path": "docs/changelog.md",
      "extra-files": [
        {
          "type": "json",
          "path": "console/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "site/index.html"
        }
      ]
    }
  }
}
